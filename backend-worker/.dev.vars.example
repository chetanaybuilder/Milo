# Copy this file to .dev.vars and fill in your keys.
# .dev.vars is used by `wrangler dev` for local development.
# For production, use `wrangler secret put <KEY_NAME>`.

# Get this key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get this key from https://app.tavily.com/home
TAVILY_API_KEY=your_tavily_api_key_here

# Comma-separated list of allowed origins (your Cloudflare Pages URL)
CORS_ORIGINS=http://localhost:5173
